# EXAMPLE ONLY. Set real values securely in the hosting platform, never in Git.
# Test/live mode is intrinsic to the key itself (sk_test_/sk_live_), so there is
# no separate mode flag to leave mismatched.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_ENABLED=false
# Enable only for isolated preview builds. No live checkout/auth in this mode.
VITE_STORE_PREVIEW=true
